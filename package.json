{
  "name": "belajar-vibe-coding",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run --cwd apps/backend dev\" \"bun run --cwd apps/frontend start\"",
    "dev:backend": "bun run --cwd apps/backend dev",
    "dev:frontend": "bun run --cwd apps/frontend start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
